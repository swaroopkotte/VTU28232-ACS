// TASK 11
import java.util.*;

public class Main {
    static class Cell {
        int r, c, t;
        Cell(int r, int c, int t) {
            this.r = r; this.c = c; this.t = t;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int r = sc.nextInt(), c = sc.nextInt();
        int[][] a = new int[r][c];
        Queue<Cell> q = new LinkedList<>();

        int trees = 0;

        for (int i = 0; i < r; i++)
            for (int j = 0; j < c; j++) {
                a[i][j] = sc.nextInt();

                if (a[i][j] == 1) trees++;
                if (a[i][j] == 2) q.add(new Cell(i,j,0));
            }

        int[] dr = {-1,1,0,0};
        int[] dc = {0,0,-1,1};
        int time = 0;

        while (!q.isEmpty()) {
            Cell x = q.poll();
            time = Math.max(time, x.t);

            for (int d = 0; d < 4; d++) {
                int nr = x.r + dr[d], nc = x.c + dc[d];

                if (nr >= 0 && nr < r && nc >= 0 && nc < c &&
                    a[nr][nc] == 1) {
                    a[nr][nc] = 2;
                    trees--;
                    q.add(new Cell(nr,nc,x.t+1));
                }
            }
        }

        System.out.println("Minutes = " + (trees > 0 ? -1 : time));
    }
}
