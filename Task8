// TASK 8
import java.util.*;

public class Main {
    static class Node {
        int v;
        Node l, r;
        Node(int v) { this.v = v; }
    }

    static Node build(int[] a) {
        if (a[0] == -1) return null;

        Node root = new Node(a[0]);
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        int i = 1;

        while (!q.isEmpty() && i < a.length) {
            Node x = q.poll();

            if (a[i] != -1) {
                x.l = new Node(a[i]);
                q.add(x.l);
            }
            i++;

            if (i < a.length && a[i] != -1) {
                x.r = new Node(a[i]);
                q.add(x.r);
            }
            i++;
        }

        return root;
    }

    static boolean path(Node x, int v, List<Node> p) {
        if (x == null) return false;

        p.add(x);

        if (x.v == v || path(x.l, v, p) || path(x.r, v, p))
            return true;

        p.remove(p.size() - 1);
        return false;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++) a[i] = sc.nextInt();

        int x = sc.nextInt(), y = sc.nextInt();

        Node root = build(a);
        List<Node> p = new ArrayList<>(), q = new ArrayList<>();

        path(root, x, p);
        path(root, y, q);

        int ans = -1;

        for (int i = 0; i < Math.min(p.size(), q.size()); i++) {
            if (p.get(i).v != q.get(i).v) break;
            ans = p.get(i).v;
        }

        System.out.println("LCA = " + ans);
    }
}
